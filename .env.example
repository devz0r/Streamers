# The Odds API free-tier key: https://the-odds-api.com/
# Without this the tool falls back to data/lines_week_N.csv, then to the
# nflverse schedule's closing lines, then to the last cached pull. It never
# hard-fails on a missing key.
ODDS_API_KEY=

# --- In-season league sync (optional; both blocks are independent) ---------
# ESPN: league id from the URL, plus the espn_s2 and SWID cookies from a
# logged-in browser session (README, "Syncing your leagues"). ESPN_TEAM_ID is
# only needed if the cookies do not identify your team unambiguously.
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=
ESPN_TEAM_ID=

# Yahoo, browser session (the working route). Yahoo stopped provisioning the
# developer API in 2026, so the league is read the same way ESPN is: with your
# own logged-in session.
#
# Easiest: DevTools -> Network -> reload -> click the page request -> Request
# Headers -> Cookie, and paste that one line here.
#
# Any of these also work -- the value is normalised on read:
#   * rows copied out of the DevTools cookie STORAGE table
#     (name <TAB> value <TAB> domain <TAB> ...), one per line
#   * one name=value per line
# It expires every few months; re-copy it when a sync starts failing.
YAHOO_COOKIE=
YAHOO_LEAGUE_ID=
YAHOO_TEAM_ID=

# Yahoo, developer API (only if Yahoo has granted your Client ID access; see
# README). Not needed when YAHOO_COOKIE is set.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=
